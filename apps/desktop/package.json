{
  "name": "@credential-manager/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Electron Desktop Shell for Credential Management System",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "package": "pnpm build && electron-builder --win",
    "clean": "rimraf dist dist-electron release *.tsbuildinfo",
    "lint": "tsc --noEmit",
    "test": "echo \"Phase 1: Desktop baseline verified\""
  },
  "dependencies": {
    "@credential-manager/config": "workspace:*",
    "@credential-manager/types": "workspace:*"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.toptechdevelopers.credentialmanager",
    "productName": "CredentialManager",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Credential Manager"
    }
  }
}
