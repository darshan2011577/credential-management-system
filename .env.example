# ==============================================================================
# Credential Management System - Environment Configuration (.env.example)
# ==============================================================================

# Server Environment & Port (Local Only)
NODE_ENV=development
API_PORT=5000
API_HOST=127.0.0.1

# MongoDB Atlas (Primary Cloud Database)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://student_user:SecurePassword123@cluster0.mongodb.net
MONGODB_DATABASE=credential_manager_db

# Redis (High-speed cache & rate limiting in Docker/Local)
REDIS_URL=redis://127.0.0.1:6379

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_access_token_key_change_me_in_production_32bytes
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_me_in_production_32bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM Master Encryption Key for Credential Passwords (32 hex bytes / 64 characters)
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=developer.test@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM="Credential Manager System <noreply@toptechdevelopers.com>"

# License Verification (Public Key for RSA-SHA256 signature verification in Client/Local API)
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"
